{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kaizen-mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "kaizen-mobile-web-local-worknest",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_WORKNEST_URL=http://localhost:3000",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8083"
      ],
      "port": 8083
    }
  ]
}